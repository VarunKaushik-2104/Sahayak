# Copy to backend/.env or export. Everything has a safe development default except SECRET_KEY in production.
DATABASE_URL=sqlite:///./sahayak.db          # or postgresql+psycopg://user:pass@host/db
SECRET_KEY=generate-with-python-secrets-token_urlsafe-48

SITE_URL=http://localhost:8000               # public address: canonical links, sitemap, structured data
CONTACT_EMAIL=                               # optional, shown on the contact page
SEED_DEMO=0                                  # 1 = development-only sample class; never on a live site
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=                                # comma separated, only if the web app is hosted elsewhere
